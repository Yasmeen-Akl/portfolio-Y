# Copy this file to .env and fill the two Supabase values in
# (Supabase dashboard → Project Settings → API).
# Until they exist, the site runs on the local seed data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: email notification for each contact-form message (https://web3forms.com → access key).
# Leave empty to skip the email; messages are still saved to the dashboard inbox.
VITE_WEB3FORMS_KEY=
